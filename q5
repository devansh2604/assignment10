#include <iostream>
#include <unordered_set>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node(int d) : data(d), next(NULL) {}
};

int main() {
    Node* head = new Node(1);
    head->next = new Node(2);
    head->next->next = new Node(3);
    head->next->next->next = new Node(4);

    // Creating loop: node 4 points to node 2
    head->next->next->next->next = head->next;

    unordered_set<Node*> visited;

    Node* curr = head;
    bool hasLoop = false;

    while (curr) {
        if (visited.count(curr)) {
            hasLoop = true;
            break;
        }
        visited.insert(curr);
        curr = curr->next;
    }

    cout << (hasLoop ? "true" : "false");

    return 0;
}
