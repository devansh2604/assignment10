#include <iostream>
#include <unordered_map>
using namespace std;

int main() {
    int nums[] = {4, 5, 1, 2, 0, 4};
    int n = 6;

    unordered_map<int, int> freq;

    for (int i = 0; i < n; i++)
        freq[nums[i]]++;

    for (int i = 0; i < n; i++) {
        if (freq[nums[i]] == 1) {
            cout << nums[i];
            return 0;
        }
    }

    cout << "No non-repeating element";
    return 0;
}
