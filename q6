#include <iostream>
#include <unordered_set>
using namespace std;

struct Node {
    int data;
    Node* left;
    Node* right;
    Node(int d) : data(d), left(NULL), right(NULL) {}
};

bool checkDuplicates(Node* root, unordered_set<int>& s) {
    if (!root) return false;

    if (s.count(root->data)) return true;

    s.insert(root->data);

    return checkDuplicates(root->left, s) ||
           checkDuplicates(root->right, s);
}

int main() {
    Node* root = new Node(5);
    root->left = new Node(3);
    root->right = new Node(7);
    root->left->left = new Node(2);
    root->right->left = new Node(3);  // duplicate

    unordered_set<int> s;

    bool ans = checkDuplicates(root, s);

    if (ans) cout << "Duplicates Found";
    else cout << "No Duplicates";

    return 0;
}
